  "lessons": [
    {
      "id": "loop",
      "text": "loop",
      "set": 1,
      "instruction": "Let l reach the top line. Keep o at the dashed line; p drops below the baseline."
    },
    {
      "id": "pool",
      "text": "pool",
      "set": 1,
      "instruction": "Start with p, join the two round o letters, and finish with a tall l."
    },
    {
      "id": "hello",
      "text": "hello",
      "set": 1,
      "instruction": "Let h and both l letters reach the top. Keep e and o between the dashed line and baseline."
    },
    {
      "id": "hope",
      "text": "hope",
      "set": 2,
      "instruction": "Use tall h, round o, a descending p, and a small e."
    },
    {
      "id": "help",
      "text": "help",
      "set": 2,
      "instruction": "Keep e small; h and l reach the top, and p drops below the baseline."
    },
    {
      "id": "peel",
      "text": "peel",
      "set": 2,
      "instruction": "Connect the two small e loops before finishing with a tall l."
    },
    {
      "id": "heel",
      "text": "heel",
      "set": 3,
      "instruction": "Keep both e loops in the lower band between tall h and l."
    },
    {
      "id": "hole",
      "text": "hole",
      "set": 3,
      "instruction": "Join tall h to small o, then tall l to small e."
    },
    {
      "id": "pole",
      "text": "pole",
      "set": 3,
      "instruction": "Let p descend, keep o and e small, and raise l to the top."
    }
  ]
